<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import java.time.LocalDate?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.crudjavafx.CRUDPersonalController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <left>
        <VBox spacing="10.0" alignment="TOP_CENTER">
            <BorderPane.margin>
                <Insets top="5.0" right="5.0" bottom="5.0" left="5.0" />
            </BorderPane.margin>
            <padding>
                <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
            </padding>
            <Label text="Formulario / Filtro de Personal">
                <font>
                    <Font name="Cooper Black" size="16.0" />
                </font>
            </Label>

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="10.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                </rowConstraints>

                <Label text="ID Personal:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="idText" disable="true" editable="false" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="nombreText" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="apellidoText" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Puesto:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="puestoText" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Fecha Nacimiento:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <DatePicker fx:id="fechaNacimientoPicker" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <ComboBox fx:id="categoriaComboBox" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <Label text="Género:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                <ComboBox fx:id="generoComboBox" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                <Label text="Activo (Guardar):" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                <CheckBox fx:id="activoCheckBox" selected="true" text="Sí" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                <Region GridPane.columnIndex="0" GridPane.rowIndex="8" GridPane.columnSpan="2" prefHeight="10" />

                <Label text="Filtro Estado Activo:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                <ComboBox fx:id="estadoActivoComboBox" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="9" />
            </GridPane>

            <HBox spacing="10.0" alignment="CENTER">
                <Button onAction="#guardarPersonal" text="Guardar" />
                <Button onAction="#eliminarPersonal" text="Eliminar" />
                <Button onAction="#filtrarPersonal" text="Filtrar" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER">
                <Button onAction="#recargarDatos" text="Recargar Datos" />
                <Button onAction="#limpiarForm" text="Limpiar Form" />
            </HBox>

            <Button onAction="#probarConexión" text="Probar Conexión" />

        </VBox>
    </left>
    <center>
        <TableView fx:id="tablaPersonal" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="columnaId" text="ID" prefWidth="40.0" />
                <TableColumn fx:id="columnaNombre" text="Nombre" prefWidth="100.0" />
                <TableColumn fx:id="columnaApellido" text="Apellido" prefWidth="120.0" />
                <TableColumn fx:id="columnaPuesto" text="Puesto" prefWidth="150.0" />
                <TableColumn fx:id="columnaCategoria" text="Categoría" prefWidth="100.0" />
                <TableColumn fx:id="columnaGenero" text="Género" prefWidth="60.0" />
                <TableColumn fx:id="columnaFechaNac" text="Fecha Nac." prefWidth="100.0" />
                <TableColumn fx:id="columnaActivo" text="Activo" prefWidth="60.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>