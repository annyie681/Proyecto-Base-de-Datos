<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="500.0" spacing="20.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.crudjavafx.MenuController">
    <children>
        <Label text="MENÚ PRINCIPAL" VBox.vgrow="NEVER">
            <font>
                <Font name="Cooper Black" size="30.0" />
            </font>
            <VBox.margin>
                <Insets top="30.0" />
            </VBox.margin>
        </Label>
        <Label text="Seleccione el módulo a gestionar:" VBox.vgrow="NEVER">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <GridPane hgap="20.0" vgap="15.0" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
            </columnConstraints>

            <Button fx:id="btnPacientes" mnemonicParsing="false" onAction="#abrirCRUD" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #2980b9;" text="1. Pacientes" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <font><Font name="Copperplate Gothic Bold" size="13.0" /></font>
            </Button>
            <Button fx:id="btnPersonal" mnemonicParsing="false" onAction="#abrirCRUD" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #27ae60;" text="2. Personal (Staff)" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <font><Font name="Copperplate Gothic Bold" size="13.0" /></font>
            </Button>

            <Button fx:id="btnDirecciones" mnemonicParsing="false" onAction="#abrirCRUD" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #f39c12;" text="3. Direcciones" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <font><Font name="Copperplate Gothic Bold" size="13.0" /></font>
            </Button>
            <Button fx:id="btnFacturas" mnemonicParsing="false" onAction="#abrirCRUD" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #e74c3c;" text="4. Facturas (Bills)" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <font><Font name="Copperplate Gothic Bold" size="13.0" /></font>
            </Button>

            <Button fx:id="btnItemsFactura" mnemonicParsing="false" onAction="#abrirCRUD" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #9b59b6;" text="5. Ítems de Factura" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <font><Font name="Copperplate Gothic Bold" size="13.0" /></font>
            </Button>
            <Button fx:id="btnEstancias" mnemonicParsing="false" onAction="#abrirCRUD" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #1abc9c;" text="6. Estancias (Rooms)" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <font><Font name="Copperplate Gothic Bold" size="13.0" /></font>
            </Button>

            <Button fx:id="btnComponentes" mnemonicParsing="false" onAction="#abrirCRUD" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #f1c40f;" text="7. Catálogo Componentes" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <font><Font name="Copperplate Gothic Bold" size="13.0" /></font>
            </Button>
            <Button fx:id="btnRelacionesDir" mnemonicParsing="false" onAction="#abrirCRUD" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #34495e;" text="8. Historial de Direcciones" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <font><Font name="Copperplate Gothic Bold" size="13.0" /></font>
            </Button>

        </GridPane>

        <Label text="*El menú principal se ocultará al abrir un módulo y regresará al cerrarlo." textFill="#606060" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>